{
    "format_version": "1.8.0",
    "minecraft:spawn_rules": {
        "description": {
            "identifier": "mighty:tralalero_tralala",
            "population_control": "monster"
        },
        "conditions": [
            {
                "minecraft:spawns_on_surface": {},
                "minecraft:spawns_on_block_filter": "minecraft:grass_block",
                "minecraft:brightness_filter": {
                    "min": 0,
                    "max": 7,
                    "adjust_for_weather": true
                },
                "minecraft:difficulty_filter": {
                    "min": "easy",
                    "max": "hard"
                },
                "minecraft:weight": {
                    "default": 35
                },
                "minecraft:herd": {
                    "min_size": 1,
                    "max_size": 2
                },
                "minecraft:biome_filter": {
                    "any_of": [
                        {
                            "test": "has_biome_tag",
                            "operator": "==",
                            "value": "beach"
                        },
                        {
                            "test": "has_biome_tag",
                            "operator": "==",
                            "value": "ocean"
                        },
                        {
                            "test": "has_biome_tag",
                            "operator": "==",
                            "value": "overworld"
                        }
                    ]
                }
            }
        ]
    }
}

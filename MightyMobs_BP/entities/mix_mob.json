{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "mighty:mix_mob",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:type_family": {
                "family": ["mix_mob", "mighty_mob", "mob"]
            },
            "minecraft:health": {
                "value": 100,
                "max": 100
            },
            "minecraft:attack": {
                "damage": 14
            },
            "minecraft:movement": {
                "value": 0.3
            },
            "minecraft:knockback_resistance": {
                "value": 0.7
            },
            "minecraft:scale": {
                "value": 1.8
            },
            "minecraft:collision_box": {
                "width": 1.2,
                "height": 3.6
            },
            "minecraft:movement.basic": {},
            "minecraft:navigation.walk": {
                "can_walk": true,
                "avoid_water": false,
                "can_pass_doors": true,
                "can_open_doors": true
            },
            "minecraft:jump.static": {},
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:teleport": {
                "dark_teleport_chance": 0.01,
                "light_teleport_chance": 0.01,
                "random_teleports": true,
                "max_random_teleport_time": 60,
                "min_random_teleport_time": 30,
                "random_teleport_cube": [32, 16, 32],
                "target_distance": 16,
                "target_teleport_chance": 0.15
            },
            "minecraft:shooter": {
                "def": "minecraft:arrow",
                "aux_val": 0,
                "power": 3
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 25 : 0"
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/mix_mob.json"
            },
            "minecraft:nameable": {},
            "minecraft:is_boss": {
                "should_darken_sky": false,
                "max_distance": 55,
                "hud_range": 55
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "within_radius": 25,
                "must_see": true,
                "entity_types": [
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        "max_dist": 25
                    }
                ]
            },
            "minecraft:behavior.ranged_attack": {
                "priority": 3,
                "attack_interval_min": 2,
                "attack_interval_max": 4,
                "attack_radius": 15
            },
            "minecraft:behavior.melee_attack": {
                "priority": 4,
                "speed_multiplier": 1.3,
                "track_target": true
            },
            "minecraft:behavior.random_stroll": {
                "priority": 6,
                "speed_multiplier": 0.8
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 8
            },
            "minecraft:behavior.random_look_around": {
                "priority": 8
            }
        }
    }
}

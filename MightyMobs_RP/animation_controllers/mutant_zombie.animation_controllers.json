{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.mutant_zombie": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": ["idle"],
                    "transitions": [
                        { "walking": "query.modified_move_speed > 0.1" }
                    ]
                },
                "walking": {
                    "animations": ["walk"],
                    "transitions": [
                        { "idle": "query.modified_move_speed <= 0.1" }
                    ]
                }
            }
        }
    }
}
